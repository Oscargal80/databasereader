{
  "name": "sql-copilot-admin",
  "version": "2.4.0",
  "description": "AI-Powered SQL Administration Tool",
  "main": "main.js",
  "homepage": "https://binariaos.com.py",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "web:dev": "concurrently \"npm run dev --prefix ../frontend\" \"nodemon server.js\"",
    "app:dev": "concurrently \"npm run dev --prefix ../frontend\" \"electron . --dev\"",
    "app:build": "npm run tools:fetch && rm -rf frontend-dist && cp -R ../frontend/dist ./frontend-dist && electron-builder --win --mac --linux",
    "app:build:linux": "npm run tools:fetch && rm -rf frontend-dist && cp -R ../frontend/dist ./frontend-dist && electron-builder --linux pacman AppImage",
    "app:build:mac": "npm run tools:fetch && rm -rf frontend-dist && cp -R ../frontend/dist ./frontend-dist && electron-builder --mac --arm64",
    "test": "echo \"Error: no test specified\" && exit 1",
    "tools:fetch": "node scripts/fetch-pg-tools.js"
  },
  "keywords": [],
  "author": "BinariaOS",
  "license": "ISC",
  "build": {
    "appId": "com.binariaos.sqlcopilot",
    "productName": "SQL Copilot Admin",
    "copyright": "Copyright © 2026 BinariaOS",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "**/*",
      "!node_modules/**/test/**/*",
      "!.env",
      "!.env.*",
      "!data/**",
      "!logs/**",
      "!*.log",
      "!config/*.old",
      "!test*.js",
      "!debug_db.js",
      "!diag-visual.js",
      "!patch_logger.js",
      "!revert_logger.js",
      "!services/serviceLayer.js",
      "!bin/**",
      "!.cache/**",
      "frontend-dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "maintainer": "BinariaOS <soporte@binariaos.com.py>",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "${productName} Setup ${version} ${os} ${arch}.${ext}",
    "extraResources": [
      {
        "from": "bin/${os}-${arch}",
        "to": "pg",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.5",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mssql": "^12.2.0",
    "mysql2": "^3.17.4",
    "node-cache": "^5.1.2",
    "node-firebird": "^2.0.2",
    "node-machine-id": "^1.1.12",
    "openai": "^6.22.0",
    "pg": "^8.18.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  }
}
