        "cap:sync": "npm run build --prefix frontend && npx cap sync",
        "cap:open:ios": "npx cap open ios"
    },
    "dependencies": {
        "@capacitor/cli": "^8.1.0",
        "@capacitor/core": "^8.1.0",
        "@capacitor/ios": "^8.1.0"
    }
}